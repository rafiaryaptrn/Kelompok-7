<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="ASUS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 05:57:33 PM"/>
        <attribute name="created" value="QVNVUztMQVBUT1AtOVQ3STRWMEQ7MjAyNi0wOS0xNjswOToyOToyNCBBTTsyNjI5"/>
        <attribute name="edited" value="QVNVUztMQVBUT1AtOVQ3STRWMEQ7MjAyNi0wOS0xNjswNTo1NzozMyBQTTsyOzI3NTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="pin, pinbenar, saldo, pilihanmenu, percobaan, ceksaldo, setortunai, pilihan, tariktunai, keluar" type="Integer" array="False" size=""/>
            <declare name="jumlahtarik, jumlahsetor" type="Integer" array="False" size=""/>
            <input variable="pin"/>
            <assign variable="pinbenar" expression="123456"/>
            <if expression="pin = 123456">
                <then>
                    <output expression="&quot;Pin Benar, Selamat Datang&quot;" newline="True"/>
                    <assign variable="pilihan" expression="0"/>
                    <while expression="pilihan &lt;&gt; 4">
                        <input variable="pilihan"/>
                        <if expression="pilihan = 1">
                            <then>
                                <output expression="&quot;Cek Saldo&quot;" newline="True"/>
                            </then>
                            <else/>
                        </if>
                        <if expression="pilihan = 2">
                            <then>
                                <output expression="&quot;Tarik Tunai&quot;" newline="True"/>
                            </then>
                            <else/>
                        </if>
                    </while>
                </then>
                <else>
                    <output expression="&quot;Pin Salah, Silahkan Coba Lagi&quot;" newline="True"/>
                    <breakpoint/>
                </else>
            </if>
            <output expression="&quot;Keluar&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
